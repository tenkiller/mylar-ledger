# Copy to .env (untracked). Never commit real values.
PORT=8787
DB_PATH=/data/mylar.sqlite

# Required. Generate with: npm run hash-password -w @mylar/api   (prompts without echo)
AUTH_PASSWORD_HASH=

# Hostnames the server answers to (comma-separated). Defaults to loopback names.
# ALLOWED_HOSTS=ledger.example.com

# Header carrying the real client IP behind a trusted proxy, for login rate limiting.
# TRUST_PROXY_HEADER=Fly-Client-IP

# Local development only; ignored (the server refuses to start) unless HOST is loopback.
# AUTH_DISABLED=true

# Reserved for Comic Vine work; not read yet.
# COMICVINE_API_KEY=
